# 复用 products/alpha-lp/infra 的 Postgres 实例，库名不同。
# 先起 LP 的 compose，再在本目录 `docker compose up` 创建 alpha_research。
RESEARCH_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/alpha_research

# 逗号分隔，第一个为主 RPC，其余为故障转移备用；与 products/alpha-lp 复用同一批端点即可。
# 免费兜底可以用 PublicNode：https://bsc-rpc.publicnode.com（已实测连通，无需注册，但没有
# SLA，也不支持 eth_getLogs（403）；量大/要稳定性时还是应该上付费供应商）。
BNB_RPC_URLS=

# 可选：单次 eth_getLogs 的区块跨度，不填默认 45000（按 NodeReal 实测的 50000 上限打了安全折扣）。
# 换了 RPC 提供商导致这个值报错（如 "Block range is too large"）时，调小这个值即可，不用改代码——
# 实测 Ankr 免费层的上限是 1000（不是 NodeReal 那个 45000 量级），换成 Ankr 当主 RPC 时必须调这个值。
BNB_LOG_CHUNK_SIZE=

# 实时 Swap 事件订阅用的 WebSocket 端点，阶段 0 只支持单端点。多数 RPC 提供商把 HTTPS 端点的
# 路径前缀换成 wss:// + /ws/ 即为 WSS 端点，具体格式因供应商而异，需要各自确认。免费兜底可以用
# PublicNode：wss://bsc-rpc.publicnode.com（已实测连通，推送 payload 带 blockTimestamp 字段）。
# 注意：多数 WS 供应商按流量（字节数）计费，不是按订阅次数——活跃池子 24/7 订阅可能比预期贵，
# 见实施记录里的成本分析。
BNB_WSS_URL=

# live-signal 的 /conclusion 候选集（逗号分隔的池子地址），必填——CompositeScore 是候选集内的
# 相对排名，不填会导致端点直接报错，而不是默默拿全部 qualified 候选池当候选集（那样会很慢，
# 也会混入不相关的历史候选池，见 live_signal/main.py 文档）。
LIVE_SIGNAL_POOL_ADDRESSES=0x46cf1cf8c69595804ba91dfdd8d6b960c9b0a7c4,0xe531fcb1f5a195de7608b9f4f9518544c2cdb693

# 可选：The Graph 的 API key，配了才会用 PancakeSwap 官方 Subgraph 补历史 TVL/24h volume
# （GeckoTerminal 只有"今天"是真实值，见 alpha_datasources/geckoterminal.py 的模块说明）。
# 不配也能跑，只是历史 TVL/volume 会退化成 NULL。免费额度每月 10 万次查询，去
# thegraph.com/studio 注册拿 key，见部署记录里的用量分析。
THEGRAPH_API_KEY=
