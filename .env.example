# 复用 products/alpha-lp/infra 的 Postgres 实例，库名不同。
# 先起 LP 的 compose，再在本目录 `docker compose up` 创建 alpha_research。
RESEARCH_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/alpha_research

# 逗号分隔，第一个为主 RPC，其余为故障转移备用；与 products/alpha-lp 复用同一批端点即可。
BNB_RPC_URLS=

# 可选：单次 eth_getLogs 的区块跨度，不填默认 45000（按 alpha-lp 生产 RPC 实测的 50000 上限打了安全折扣）。
# 换了 RPC 提供商导致这个值报错（如 "exceed maximum block range"）时，调小这个值即可，不用改代码。
BNB_LOG_CHUNK_SIZE=
